---
interface Props {
  /** Prefix for form field IDs when multiple signups appear on one page */
  idPrefix?: string;
}

const { idPrefix = 'bd' } = Astro.props;
const emailId = `${idPrefix}-email`;
---

<form
  action="https://buttondown.com/api/emails/embed-subscribe/SteveRostron"
  method="post"
  target="popupwindow"
  onsubmit="window.open('https://buttondown.com/SteveRostron', 'popupwindow')"
  class="newsletter-signup"
>
  <label for={emailId} class="newsletter-signup-label">Get notified when benefit rates or rules change</label>
  <div class="newsletter-signup-row">
    <input type="email" name="email" id={emailId} placeholder="you@example.com" required />
    <input type="hidden" value="1" name="embed" />
    <button type="submit">Subscribe</button>
  </div>
  <p class="newsletter-signup-note">One email when rates change each April, plus occasional new guide alerts. Unsubscribe anytime.</p>
</form>

<style>
  .newsletter-signup {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    text-align: left;
  }

  .newsletter-signup-label {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .newsletter-signup-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .newsletter-signup input[type='email'] {
    flex: 1 1 200px;
    min-width: 0;
    padding: 12px 14px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .newsletter-signup input[type='email']::placeholder {
    color: #7a9ec0;
  }

  .newsletter-signup input[type='email']:focus {
    border-color: #c8102e;
    background: rgba(255, 255, 255, 0.12);
  }

  .newsletter-signup button {
    padding: 12px 20px;
    background: #c8102e;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .newsletter-signup button:hover {
    background: #a00d24;
  }

  .newsletter-signup-note {
    font-size: 12px;
    color: #7a9ec0;
    line-height: 1.5;
    margin-top: 0.65rem;
  }
</style>
