---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { categoryLabels } from '../../data/guideCategories';

const allGuides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const GUIDE_LIMIT = 9;
const guides = allGuides.slice(0, GUIDE_LIMIT);
const hasMore = allGuides.length > GUIDE_LIMIT;
---

<Base
  showHeader
  title="Benefits Guides | BenefitsCheck.co.uk"
  description="Free, plain-English guides to UK benefits — Universal Credit, PIP, Carer's Allowance, Pension Credit and more. Written to help you understand what you're entitled to."
>

  <style is:global>
    body { background: #dcdbd6; }

    .guides-page {
      max-width: 1060px;
      margin: 0 auto;
      padding: 3.5rem 2rem 4.5rem;
    }

    .guides-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #c8102e;
      margin-bottom: 0.5rem;
    }

    .guides-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      color: #0d1f3c;
      margin-bottom: 0.75rem;
      line-height: 1.2;
    }

    .guides-subtitle {
      font-size: 15px;
      color: #555;
      line-height: 1.65;
      max-width: 620px;
      margin-bottom: 2rem;
    }

    .category-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2.5rem;
    }

    .category-filter {
      font-size: 12px;
      font-weight: 600;
      color: #0d1f3c;
      background: #fff;
      border: 1.5px solid #d0cfc9;
      border-radius: 999px;
      padding: 6px 14px;
      text-decoration: none;
      transition: all 0.15s;
    }

    .category-filter:hover {
      border-color: #0d1f3c;
      background: #f5f4f0;
    }

    .guide-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      align-items: stretch;
    }

    .guides-empty {
      font-size: 15px;
      color: #555;
      line-height: 1.65;
    }

    .guides-view-all {
      text-align: center;
      margin-top: 2.5rem;
    }

    .guides-view-all a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      background: #0d1f3c;
      padding: 11px 22px;
      border-radius: 10px;
      text-decoration: none;
      transition: background 0.15s;
    }

    .guides-view-all a:hover {
      background: #c8102e;
    }

    .pip2-featured {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 1.5rem;
      margin: 0 0 2rem;
      padding: 1.35rem 1.5rem;
      background: #0d1f3c;
      border-radius: 14px;
      border-top: 4px solid #c8102e;
      color: #fff;
    }

    .pip2-featured-copy {
      flex: 1 1 260px;
    }

    .pip2-featured-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #c8102e;
      margin-bottom: 0.35rem;
    }

    .pip2-featured-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.25rem, 2.5vw, 1.55rem);
      line-height: 1.25;
      margin-bottom: 0.4rem;
    }

    .pip2-featured-text {
      font-size: 14px;
      color: #a8c0d8;
      line-height: 1.55;
      max-width: 36rem;
    }

    .pip2-featured-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 11px 18px;
      background: #c8102e;
      color: #fff;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s;
    }

    .pip2-featured-btn:hover {
      background: #e8192e;
    }

    @media (max-width: 600px) {
      .guides-page {
        padding: 2.5rem 1.25rem 3.5rem;
      }
    }
  </style>

  <div class="guides-page">
    <p class="guides-eyebrow">Free UK benefit guides</p>
    <h1 class="guides-title">Benefits Guides</h1>
    <p class="guides-subtitle">
      Plain-English guides to help you understand UK benefits — who qualifies, how to claim, and what to watch out for.
    </p>

    <nav class="category-filters" aria-label="Browse by category">
      {Object.entries(categoryLabels).map(([slug, label]) => (
        <a href={`/guides/${slug}/`} class="category-filter">{label}</a>
      ))}
    </nav>

    <aside class="pip2-featured" aria-label="Featured PIP2 guide">
      <div class="pip2-featured-copy">
        <p class="pip2-featured-label">Featured · Free tool</p>
        <p class="pip2-featured-title">Free PIP2 Form Guide</p>
        <p class="pip2-featured-text">
          Walk through every PIP activity with descriptors, point values, sample answers, and a simple score tracker.
        </p>
      </div>
      <a href="/guides/pip2-form-guide/" class="pip2-featured-btn">Open Free PIP2 Guide →</a>
    </aside>

    {guides.length === 0 ? (
      <p class="guides-empty">No guides published yet. Check back soon.</p>
    ) : (
      <>
        <div class="guide-grid">
          {guides.map((guide) => (
            <GuideCard guide={guide} />
          ))}
        </div>
        {hasMore && (
          <div class="guides-view-all">
            <a href="/guides/all/">View all guides →</a>
          </div>
        )}
      </>
    )}
  </div>
</Base>
