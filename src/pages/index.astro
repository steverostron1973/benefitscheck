---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';
import { guideCategories, categoryLabels } from '../data/guideCategories';

const latestGuides = (await getCollection('guides'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const categoryTileLabels: Record<(typeof guideCategories)[number], string> = {
  ...categoryLabels,
  general: 'General Guides',
};

const categoryIcons: Record<(typeof guideCategories)[number], string> = {
  'universal-credit': '💷',
  pip: '♿',
  'carers-allowance': '🤝',
  'council-tax-reduction': '🏠',
  'housing-benefit': '🏡',
  'child-benefit': '👶',
  'pension-credit': '👴',
  'attendance-allowance': '👴',
  general: '📋',
};
---
<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: #dcdbd6; color: #1a1a1a; }

  /* Hero */
  .hero { background: #0d1f3c; padding: 5rem 2rem 4.5rem; text-align: center; position: relative; overflow: hidden; }
  .hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #c8102e 0%, #e8192e 50%, #c8102e 100%); }
  .hero-eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; background: #c8102e; padding: 5px 16px; border-radius: 4px; margin-bottom: 1.75rem; }
  .hero-title { font-family: 'Playfair Display', serif; font-size: clamp(2.4rem, 6vw, 4.2rem); color: #fff; line-height: 1.12; margin-bottom: 1.25rem; max-width: 820px; margin-left: auto; margin-right: auto; }
  .hero-title em { color: #e8192e; font-style: normal; position: relative; }
  .hero-subtitle { font-size: clamp(1rem, 2vw, 1.15rem); color: #a8c0d8; line-height: 1.7; max-width: 580px; margin: 0 auto 3rem; }
  .hero-trust { display: flex; align-items: center; justify-content: center; gap: 2rem; flex-wrap: wrap; }
  .hero-trust-item { display: flex; align-items: center; gap: 7px; font-size: 13px; color: #7a9ec0; font-weight: 500; }
  .hero-trust-dot { width: 6px; height: 6px; background: #c8102e; border-radius: 50%; flex-shrink: 0; }

  /* Announce strip */
  .pip-announce {
    position: sticky;
    top: var(--site-header-height);
    z-index: 90;
    background: #c8102e;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    padding: 0.7rem 2.5rem;
    text-align: center;
    box-shadow: 0 4px 16px rgba(200, 16, 46, 0.35);
  }
  .pip-announce[hidden] { display: none; }
  .pip-announce-text {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
    margin: 0;
  }
  .pip-announce-text a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pip-announce-text a:hover { color: #ffe8ec; }
  .pip-announce-close {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    opacity: 0.9;
  }
  .pip-announce-close:hover { background: rgba(0,0,0,0.15); opacity: 1; }

  /* PIP Tools feature section */
  .pip-tools-section {
    background: #c8c7c1;
    padding: 3.5rem 2rem 4rem;
    border-bottom: 1px solid #b8b7b1;
  }
  .pip-tools-inner { max-width: 1060px; margin: 0 auto; }
  .pip-tools-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8102e;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .pip-tools-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    color: #0d1f3c;
    text-align: center;
    margin-bottom: 0.6rem;
  }
  .pip-tools-subtitle {
    font-size: 15px;
    color: #444;
    text-align: center;
    margin-bottom: 2.25rem;
    line-height: 1.65;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .pip-tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.35rem;
  }
  .pip-feature-card {
    border-radius: 16px;
    padding: 2rem 1.85rem 1.85rem;
    color: #fff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 36px rgba(13, 31, 60, 0.18);
    min-height: 100%;
  }
  .pip-feature-card--navy { background: linear-gradient(160deg, #0d1f3c 0%, #132a4d 100%); }
  .pip-feature-card--red { background: linear-gradient(160deg, #c8102e 0%, #a00d24 100%); }
  .pip-feature-label {
    display: inline-block;
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 4px;
    margin-bottom: 1.1rem;
  }
  .pip-feature-card--navy .pip-feature-label {
    background: #c8102e;
    color: #fff;
  }
  .pip-feature-card--red .pip-feature-label {
    background: rgba(255,255,255,0.18);
    color: #fff;
  }
  .pip-feature-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.55rem, 2.5vw, 1.9rem);
    line-height: 1.2;
    margin-bottom: 0.85rem;
    color: #fff;
  }
  .pip-feature-desc {
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 1.25rem;
    flex: 1;
  }
  .pip-feature-card--navy .pip-feature-desc { color: #a8c0d8; }
  .pip-feature-card--red .pip-feature-desc { color: rgba(255,255,255,0.88); }
  .pip-feature-list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .pip-feature-list li {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
    padding-left: 1.35rem;
    position: relative;
  }
  .pip-feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
  }
  .pip-feature-card--navy .pip-feature-list li { color: #e8eef5; }
  .pip-feature-card--navy .pip-feature-list li::before { color: #c8102e; }
  .pip-feature-card--red .pip-feature-list li { color: #fff; }
  .pip-feature-card--red .pip-feature-list li::before { color: rgba(255,255,255,0.95); }
  .pip-feature-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    align-self: flex-start;
    padding: 12px 22px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .pip-feature-card--navy .pip-feature-cta {
    background: #fff;
    color: #0d1f3c;
  }
  .pip-feature-card--navy .pip-feature-cta:hover {
    background: #c8102e;
    color: #fff;
  }
  .pip-feature-card--red .pip-feature-cta {
    background: #fff;
    color: #c8102e;
  }
  .pip-feature-card--red .pip-feature-cta:hover {
    background: #0d1f3c;
    color: #fff;
  }

  .bpd-home-card {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 2px solid #0d1f3c;
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 18px rgba(13, 31, 60, 0.08);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .bpd-home-card:hover {
    border-color: #c8102e;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(13, 31, 60, 0.12);
  }
  .bpd-home-card-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8102e;
    margin-bottom: 0.35rem;
  }
  .bpd-home-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    color: #0d1f3c;
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }
  .bpd-home-card-desc {
    font-size: 14px;
    color: #555;
    line-height: 1.5;
    margin: 0;
  }
  .bpd-home-card-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 18px;
    background: #0d1f3c;
    color: #fff;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .bpd-home-card:hover .bpd-home-card-cta { background: #c8102e; }

  /* Stats bar */
  .stats-bar { background: #091629; padding: 0; display: flex; justify-content: center; }
  .stat-item { text-align: center; padding: 1.75rem 3rem; border-right: 1px solid #1a3050; flex: 1; max-width: 280px; }
  .stat-item:last-child { border-right: none; }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 2.8rem; color: #c8102e; line-height: 1; margin-bottom: 6px; }
  .stat-label { font-size: 12px; color: #7a9ec0; font-weight: 500; line-height: 1.5; }

  /* Checkers section */
  .checkers-section { padding: 4.5rem 2rem; max-width: 1060px; margin: 0 auto; }
  .section-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #c8102e; text-align: center; margin-bottom: 0.5rem; }
  .section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.4rem); color: #0d1f3c; text-align: center; margin-bottom: 0.75rem; }
  .section-subtitle { font-size: 15px; color: #555; text-align: center; margin-bottom: 3rem; line-height: 1.65; max-width: 580px; margin-left: auto; margin-right: auto; }

  .checker-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }

  .checker-card { background: #fff; border: 2px solid #d0cfc9; border-radius: 16px; padding: 2rem; text-decoration: none; color: inherit; transition: all 0.2s; display: flex; flex-direction: column; position: relative; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
  .checker-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: #0d1f3c; transition: background 0.2s; }
  .checker-card:hover { border-color: #0d1f3c; transform: translateY(-3px); box-shadow: 0 12px 40px rgba(13,31,60,0.12); }
  .checker-card:hover::before { background: #c8102e; }
  .checker-card.coming-soon { opacity: 0.5; cursor: default; }
  .checker-card.coming-soon:hover { transform: none; box-shadow: none; border-color: #e0dfd9; }
  .checker-card.coming-soon::before { background: #ccc; }
  .checker-card.coming-soon:hover::before { background: #ccc; }

  .checker-card-badge { position: absolute; top: 1.25rem; right: 1.25rem; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 10px; border-radius: 4px; }
  .badge-live { background: #0d1f3c; color: #fff; }
  .badge-soon { background: #e8e7e2; color: #888; }

  .checker-card-icon { font-size: 2.5rem; margin-bottom: 1rem; margin-top: 0.5rem; }
  .checker-card-title { font-family: 'Playfair Display', serif; font-size: 1.45rem; color: #0d1f3c; margin-bottom: 0.6rem; line-height: 1.2; }
  .checker-card-hook { font-size: 14px; font-weight: 600; color: #c8102e; margin-bottom: 0.75rem; line-height: 1.45; }
  .checker-card-desc { font-size: 13px; color: #555; line-height: 1.65; flex: 1; margin-bottom: 1.25rem; }
  .checker-card-stat { font-size: 12px; color: #555; margin-bottom: 1.5rem; padding: 0.65rem 0.9rem; background: #f5f4f0; border-radius: 8px; line-height: 1.4; border-left: 3px solid #0d1f3c; }
  .checker-card-stat strong { color: #0d1f3c; }

  .checker-card-btn { display: inline-flex; align-items: center; gap: 6px; padding: 11px 22px; background: #0d1f3c; color: #fff; border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none; transition: background 0.15s; align-self: flex-start; }
  .checker-card-btn:hover { background: #c8102e; }
  .checker-card-btn.disabled { background: #e0dfd9; color: #999; cursor: default; pointer-events: none; }

  /* Guides section */
  .guides-section { padding: 4.5rem 2rem; max-width: 1060px; margin: 0 auto; }
  .category-tile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 0.5rem; }
  .category-tile {
    background: linear-gradient(145deg, #eef1f5 0%, #e4e9ef 100%);
    border: 2px solid #d0cfc9;
    border-radius: 14px;
    padding: 1.25rem 1.35rem;
    text-decoration: none;
    color: #0d1f3c;
    font-weight: 600;
    font-size: 14px;
    line-height: 1.35;
    transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 68px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(13, 31, 60, 0.06);
  }
  .category-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #0d1f3c;
    transition: background 0.2s;
  }
  .category-tile-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.45rem;
    line-height: 1;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(13, 31, 60, 0.08);
    border-radius: 10px;
    transition: background 0.2s, transform 0.2s;
  }
  .category-tile-label { position: relative; z-index: 1; }
  .category-tile:hover {
    background: linear-gradient(145deg, #e2e8f0 0%, #d5dde8 100%);
    border-color: #0d1f3c;
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(13, 31, 60, 0.12);
  }
  .category-tile:hover::before { background: #c8102e; }
  .category-tile:hover .category-tile-icon {
    background: #fff;
    transform: scale(1.05);
  }
  .guides-latest-heading {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    color: #0d1f3c;
    text-align: center;
    margin: 3rem 0 1.5rem;
    font-weight: 700;
  }
  .guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
  .guides-view-all { text-align: center; }
  .guides-view-all a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: #0d1f3c;
    padding: 11px 22px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .guides-view-all a:hover { background: #c8102e; }

  /* How it works */
  .how-section { background: #0d1f3c; padding: 4.5rem 2rem; }
  .how-inner { max-width: 860px; margin: 0 auto; }
  .how-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #c8102e; text-align: center; margin-bottom: 0.5rem; }
  .how-title { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); color: #fff; text-align: center; margin-bottom: 3rem; }
  .how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .how-step { text-align: center; }
  .how-step-num { width: 48px; height: 48px; background: #c8102e; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; margin: 0 auto 1.25rem; }
  .how-step-title { font-size: 15px; font-weight: 700; color: #fff; margin-bottom: 0.5rem; }
  .how-step-desc { font-size: 13px; color: #7a9ec0; line-height: 1.65; }

  /* Disclaimer strip */
  .disclaimer-strip { background: #f5f4f0; border-top: 1px solid #e0dfd9; border-bottom: 1px solid #e0dfd9; padding: 1.25rem 2rem; text-align: center; }
  .disclaimer-strip p { font-size: 12px; color: #888; line-height: 1.6; max-width: 700px; margin: 0 auto; }
  .disclaimer-strip strong { color: #555; }

  /* Footer */
  .footer { background: #091629; padding: 2.5rem 2rem; text-align: center; }
  .footer-logo { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: #fff; margin-bottom: 1.25rem; }
  .footer-logo span { color: #c8102e; }
  .footer-links { display: flex; justify-content: center; gap: 2rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .footer-link { font-size: 13px; color: #7a9ec0; text-decoration: none; transition: color 0.15s; }
  .footer-link:hover { color: #fff; }
  .footer-copy { font-size: 11px; color: #3a5070; line-height: 1.6; }

  @media (max-width: 1100px) {
    .pip-tools-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .how-steps { grid-template-columns: 1fr; gap: 2rem; }
    .stats-bar { flex-direction: column; }
    .stat-item { border-right: none; border-bottom: 1px solid #1a3050; max-width: 100%; padding: 1.25rem; }
    .stat-item:last-child { border-bottom: none; }
    .hero { padding: 3rem 1.25rem 3rem; }
    .pip-announce { padding: 0.75rem 2.75rem 0.75rem 1.25rem; }
    .pip-announce-text { font-size: 12px; }
    .pip-tools-section { padding: 2.75rem 1.25rem 3.25rem; }
    .pip-feature-card { padding: 1.65rem 1.4rem 1.5rem; }
  }
</style>

<Base
  showHeader
  title="BenefitsCheck UK — Free Benefit Checkers for Every Situation"
  description="Free UK benefit checkers for working parents, pensioners, carers and more. Find out what you're entitled to in 60 seconds. No sign-up, no long forms, 2026/27 rates."
>

<!-- Announcement strip -->
<div class="pip-announce" id="pip-announce" role="region" aria-label="New PIP tools">
  <p class="pip-announce-text">
    <a href="/pip-checker/">New: Free PIP Checker &amp; PIP2 Form Guide</a> — the UK's most detailed free PIP resources
  </p>
  <button type="button" class="pip-announce-close" id="pip-announce-close" aria-label="Dismiss announcement">×</button>
</div>
<script is:inline>
  (function () {
    try {
      if (localStorage.getItem('bc_pip_announce_dismissed') === '1') {
        var el = document.getElementById('pip-announce');
        if (el) el.hidden = true;
      }
    } catch (e) {}
  })();
</script>

<!-- Hero -->
<section class="hero">
  <div class="hero-eyebrow">Free UK Benefit Checkers · 2026/27 Rates</div>
  <h1 class="hero-title">Are you missing out on<br>benefits you're <em>entitled to?</em></h1>
  <p class="hero-subtitle">Most people in the UK are owed money they're not claiming. Our free checkers tell you exactly what — in 60 seconds, no long forms, no sign-up, nothing stored.</p>
  <div class="hero-trust">
    <span class="hero-trust-item"><span class="hero-trust-dot"></span>Completely free</span>
    <span class="hero-trust-item"><span class="hero-trust-dot"></span>No sign-up required</span>
    <span class="hero-trust-item"><span class="hero-trust-dot"></span>Your data never leaves your device</span>
    <span class="hero-trust-item"><span class="hero-trust-dot"></span>Updated for 2026/27</span>
  </div>
</section>

<!-- PIP Tools -->
<section class="pip-tools-section" aria-labelledby="pip-tools-heading">
  <div class="pip-tools-inner">
    <div class="pip-tools-eyebrow">Personal Independence Payment</div>
    <h2 class="pip-tools-title" id="pip-tools-heading">Free PIP tools — built to help you claim</h2>
    <p class="pip-tools-subtitle">Free resources covering every PIP activity: score your claim, strengthen your PIP2 answers, then draft a clearer starting point in your own words.</p>

    <div class="pip-tools-grid">
      <article class="pip-feature-card pip-feature-card--navy">
        <span class="pip-feature-label">Free interactive tool</span>
        <h3 class="pip-feature-heading">PIP Checker</h3>
        <p class="pip-feature-desc">Answer questions about how your condition affects you across 12 activities. We calculate your Daily Living and Mobility scores and show you what award you might qualify for — with condition-specific guidance.</p>
        <ul class="pip-feature-list">
          <li>Based on official 2026/27 PIP descriptors</li>
          <li>Personalised results for your condition</li>
          <li>Links to your condition-specific guide</li>
        </ul>
        <a href="/pip-checker/" class="pip-feature-cta">Start PIP Checker →</a>
      </article>

      <article class="pip-feature-card pip-feature-card--red">
        <span class="pip-feature-label">Free step-by-step guide</span>
        <h3 class="pip-feature-heading">PIP2 Form Guide</h3>
        <p class="pip-feature-desc">The complete guide to answering every question in the 'How your disability affects you' form — with official descriptors, point values, and sample answers. Free. No sign-up.</p>
        <ul class="pip-feature-list">
          <li>All 12 activities covered with descriptor points</li>
          <li>Strong and weak answer examples</li>
          <li>Interactive score tracker</li>
        </ul>
        <a href="/guides/pip2-form-guide/" class="pip-feature-cta">Open Free Guide →</a>
      </article>

      <article class="pip-feature-card pip-feature-card--navy">
        <span class="pip-feature-label">Free drafting aid</span>
