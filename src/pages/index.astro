<script>
  const announce = document.getElementById('pip-announce');
  const closeBtn = document.getElementById('pip-announce-close');
  const storageKey = 'bc_pip_announce_dismissed';

  if (announce && typeof localStorage !== 'undefined') {
    if (localStorage.getItem(storageKey) === '1') {
      announce.hidden = true;
    }
    closeBtn?.addEventListener('click', () => {
      announce.hidden = true;
      localStorage.setItem(storageKey, '1');
    });
  }
</script>

