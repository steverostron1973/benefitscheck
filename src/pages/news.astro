---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

/** Add new items here — same shape as existing cards. Newest first. */
const newsItems = [
  {
    title: 'Is the PIP 4-Point Rule Really Happening in November 2026?',
    snippet: "The '4-point rule' for PIP was scrapped in July 2025 — here's what actually changed.",
    href: '/guides/pip-4-point-rule-november-2026/',
    date: '30 July 2026',
    dateIso: '2026-07-30',
  },
];
---

<Base
  showHeader
  title="News & Updates | BenefitsCheck UK"
  description="Time-sensitive changes to UK benefits — separate from our evergreen guides, which cover the rules as they stand."
>
  <div class="news-page">
    <nav class="news-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="news-breadcrumb-sep">/</span>
      <span>News</span>
    </nav>

    <p class="news-eyebrow">Updates</p>
    <h1 class="news-title">News &amp; Updates</h1>
    <p class="news-subtitle">
      Time-sensitive changes to UK benefits — separate from our evergreen guides, which cover the rules as they stand.
    </p>

    <div class="news-list">
      {newsItems.map((item) => (
        <NewsCard
          title={item.title}
          snippet={item.snippet}
          href={item.href}
          date={item.date}
          dateTime={item.dateIso}
        />
      ))}
    </div>

    <div class="news-newsletter">
      <NewsletterSignup idPrefix="news-bd" />
    </div>
  </div>
</Base>

<style is:global>
  body { background: #dcdbd6; }
</style>

<style>
  .news-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3.5rem 2rem 4.5rem;
  }

  .news-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 13px;
    color: #888;
    margin-bottom: 1.5rem;
  }

  .news-breadcrumb a {
    color: #0d1f3c;
    font-weight: 600;
    text-decoration: none;
  }

  .news-breadcrumb a:hover {
    color: #c8102e;
  }

  .news-breadcrumb-sep {
    color: #bbb;
  }

  .news-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8102e;
    margin-bottom: 0.5rem;
  }

  .news-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: #0d1f3c;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .news-subtitle {
    font-size: 15px;
    color: #555;
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 2.25rem;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .news-newsletter {
    margin-top: 3rem;
    padding: 1.75rem 1.5rem;
    background: #fff;
    border: 2px solid #d0cfc9;
    border-radius: 16px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .news-newsletter :global(.newsletter-signup-label) {
    color: #0d1f3c;
  }

  .news-newsletter :global(input[type='email']) {
    border-color: #d0cfc9;
    background: #f5f4f0;
    color: #1a1a1a;
  }

  .news-newsletter :global(input[type='email']::placeholder) {
    color: #999;
  }

  .news-newsletter :global(input[type='email']:focus) {
    border-color: #0d1f3c;
    background: #fff;
  }

  .news-newsletter :global(.newsletter-signup-note) {
    color: #888;
  }
</style>
